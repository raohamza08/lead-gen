{
  "manifest_version": 3,
  "name": "Outly Upwork Fetcher",
  "version": "1.1.2",
  "description": "Fetches Upwork job details for Outly's Proposal Writing tool using your own logged-in browser session -- Upwork blocks server-side automated fetches, this runs in your real browser instead.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "*://*.upwork.com/*",
    "https://outly.euroshub.com/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.upwork.com/*"],
      "js": ["content-upwork.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://outly.euroshub.com/*", "http://localhost:3000/*", "http://localhost:3001/*"],
      "js": ["content-app.js"],
      "run_at": "document_idle"
    }
  ]
}
