// Prisma schema — implements the ERD in Part B4 of lead-gen-system-architecture.md
generator client {
  provider = "prisma-client-js"
  // "native" covers the developer's own machine. The musl target is required
  // for the Alpine-based container image: Prisma's default `linux-musl` engine
  // links against libssl.so.1.1, but Alpine 3.19+ (what node:20-alpine is built
  // on) ships OpenSSL 3.x, so the container booted straight into
  // "Error loading shared library libssl.so.1.1". Without this line the image
  // builds fine and only fails at runtime, which is the worst place to find out.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  LEAD_REVIEWER
  SALES_REP
  VIEWER
}

// Declaration order is funnel order — see the note on the shared PipelineStage
// enum in packages/types/src/enums.ts.
enum PipelineStage {
  NEW_LEAD
  VERIFIED
  RESEARCH_COMPLETED
  UNDER_REVIEW
  READY_FOR_OUTREACH
  EMAIL_1_SENT
  WAITING_EMAIL_2
  EMAIL_2_SENT
  WAITING_EMAIL_3
  EMAIL_3_SENT
  WAITING_EMAIL_4
  EMAIL_4_SENT
  WAITING_EMAIL_5
  EMAIL_5_SENT
  LINKEDIN_OUTREACH
  LINKEDIN_FOLLOW_UP
  REPLIED
  MEETING_BOOKED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  CLIENT_ONBOARDING
  LOST
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

/// Where a lead's data actually came from. No "dark web" value on purpose —
/// see the doc comment on the shared TS enum (@leadgen/types) for why.
enum LeadSourceLayer {
  SURFACE_WEB
  LICENSED_DATABASE
  MANUAL
  EMAIL
  SOCIAL_MEDIA
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ExtractionRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_SHORT_OF_TARGET
  FAILED
  CANCELLED
}

enum EmailProvider {
  GMAIL
  MICROSOFT_365
  SMTP
}

enum EmailAccountStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum EmailMessageStatus {
  DRAFT
  PENDING_APPROVAL
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum GeneratedBy {
  TEMPLATE
  CLAUDE
  GEMINI
  HUMAN_EDIT
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  SPAM_COMPLAINT
  UNSUBSCRIBED
  BLOCKED
  FAILED
}

enum LinkedinStatus {
  NOT_STARTED
  CONNECTION_SENT
  ACCEPTED
  MESSAGE_SENT
  REPLIED
  MEETING_SCHEDULED
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  settings     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  users        User[]
  nicheFilters NicheFilter[]
  leads        Lead[]
  emailAccounts EmailAccount[]
  caseStudies  CaseStudy[]
  suppressionEntries SuppressionEntry[]
  agentRuns    AgentRun[]
  campaigns    Campaign[]
  notifications Notification[]
  aiInsightSnapshot AiInsightSnapshot?
  inboundEmailThreads InboundEmailThread[]
  emailTags    EmailTag[]
  socialAccounts   SocialAccount[]
  socialPosts      SocialPost[]
  mediaAssets      MediaAsset[]
  mediaFolders     MediaFolder[]
  hashtagGroups    HashtagGroup[]
  contentTemplates ContentTemplate[]
  socialAutomations SocialAutomation[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id])
  email     String   @unique
  name      String
  passwordHash String  @map("password_hash")
  role      Role     @default(VIEWER)
  active    Boolean  @default(true)
  /// Per-module on/off, checked by ModuleAccessGuard (ADMIN always bypasses
  /// regardless of these). Default true so no existing user is retroactively
  /// locked out by this migration — this is a way to narrow access below a
  /// role's normal reach, not a second role system.
  leadGenAccess     Boolean @default(true) @map("lead_gen_access")
  emailHubAccess    Boolean @default(true) @map("email_hub_access")
  socialMediaAccess Boolean @default(true) @map("social_media_access")
  createdAt DateTime @default(now()) @map("created_at")

  assignedLeads Lead[] @relation("AssignedUser")
  reviewNotes   ReviewNote[]
  linkedinActivities LinkedinActivity[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  emailAccountAccess EmailAccountAccess[]
  socialAccountAccess SocialAccountAccess[]
  assignedConversations SocialConversation[]
  socialInternalNotes   SocialInternalNote[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  revoked    Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model NicheFilter {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  org            Organization @relation(fields: [orgId], references: [id])
  niche          String
  subNiche       String?  @map("sub_niche")
  countries      String[] @default([])
  cities         String[] @default([])
  companySizeMin Int?     @map("company_size_min")
  companySizeMax Int?     @map("company_size_max")
  revenueBandMin String?  @map("revenue_band_min")
  revenueBandMax String?  @map("revenue_band_max")
  employeeCountMin Int?   @map("employee_count_min")
  employeeCountMax Int?   @map("employee_count_max")
  jobTitles      String[] @default([])
  technologies   String[] @default([])
  fundingStage   String?  @map("funding_stage")
  businessModel  String?  @map("business_model")
  b2bOrB2c       String?  @map("b2b_or_b2c")

  // Targeting filters. Values are constrained to the catalogues in
  // packages/types/src/filter-taxonomy.ts, which the DTO validates against and
  // the settings UI renders — one source of truth for all three consumers.
  //
  // Every array defaults to empty, and empty means "no constraint on this
  // dimension" rather than "match nothing". That distinction matters: these
  // columns are added to filters that already exist, and the opposite reading
  // would silently stop every current filter from returning any leads.
  companyTypes         String[] @default([]) @map("company_types")
  growthStages         String[] @default([]) @map("growth_stages")
  companyKeywords      String[] @default([]) @map("company_keywords")
  departments          String[] @default([])
  seniorityLevels      String[] @default([]) @map("seniority_levels")
  yearsInBusinessMin   Int?     @map("years_in_business_min")
  yearsInBusinessMax   Int?     @map("years_in_business_max")
  hiringSignals        String[] @default([]) @map("hiring_signals")
  websiteConditions    String[] @default([]) @map("website_conditions")
  aiOpportunitySignals String[] @default([]) @map("ai_opportunity_signals")

  // Exclusions, applied after every inclusion filter. A candidate matching any
  // of these is rejected however well it scores elsewhere.
  exclusionSignals  String[] @default([]) @map("exclusion_signals")
  excludeIndustries String[] @default([]) @map("exclude_industries")
  excludeKeywords   String[] @default([]) @map("exclude_keywords")
  excludeCompanies  String[] @default([]) @map("exclude_companies")

  dailyTarget    Int      @default(100) @map("daily_target")
  sourcePriority String[] @default([]) @map("source_priority")
  // Enrichment agents to skip for this filter (company_intelligence,
  // website_audit, buyer_intelligence — the only ones the worker will ever
  // drop; discovery/verification/opportunity/scoring ignore this). Cuts the
  // pipeline from 6 Claude CLI calls per candidate to 3.
  disabledAgents String[] @default([]) @map("disabled_agents")
  scheduleCron   String   @default("0 6 * * *") @map("schedule_cron")
  timezone       String   @default("UTC")
  active         Boolean  @default(true)
  // Part C5: one ClickUp List per niche filter — config, not a hardcoded ID.
  clickupListId  String?  @map("clickup_list_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  extractionRuns ExtractionRun[]
  leads          Lead[]
  campaigns      Campaign[]

  @@map("niche_filters")
}

model ExtractionRun {
  id                String   @id @default(uuid())
  filterId          String   @map("filter_id")
  filter            NicheFilter @relation(fields: [filterId], references: [id])
  startedAt         DateTime @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  leadsFound        Int      @default(0) @map("leads_found")
  leadsVerified     Int      @default(0) @map("leads_verified")
  duplicatesSkipped Int      @default(0) @map("duplicates_skipped")
  status            ExtractionRunStatus @default(RUNNING)
  // Why a FAILED run failed. Without it the dashboard can report that a run
  // broke but never what broke, which is the first thing an operator asks.
  error             String?
  /// Leads produced per priority band, for checking the 40/40/20 mix actually
  /// held. A run that hit its total but produced only high-priority leads has
  /// spent no exploration budget, and the targeting stops improving.
  priorityMix       Json     @default("{}") @map("priority_mix")

  leads             Lead[]

  @@map("extraction_runs")
}

/// A campaign groups a niche, an offer and a message sequence so performance
/// can be attributed. Without it "best offer" and "best sequence" are
/// unanswerable — every lead looks the same to analytics, and the learning loop
/// has nothing to compare against.
model Campaign {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  org           Organization @relation(fields: [orgId], references: [id])
  name          String
  niche         String
  country       String?
  /// What is being sold in this campaign, in the operator's own words. Feeds
  /// the email prompts, so it is a real input, not a label.
  offer         String?
  caseStudy     String?  @map("case_study")
  goal          String?
  targetLeads   Int      @default(100) @map("target_leads")
  /// Per-step subject/angle overrides. Empty means use the default sequence.
  emailSequence Json     @default("[]") @map("email_sequence")
  linkedinSequence Json  @default("[]") @map("linkedin_sequence")
  /// Optional niche filter that feeds this campaign.
  filterId      String?  @map("filter_id")
  filter        NicheFilter? @relation(fields: [filterId], references: [id])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  leads         Lead[]
  socialPosts   SocialPost[]

  @@index([orgId, active])
  @@map("campaigns")
}

/// One agent execution. Written by the workers after every agent run so the
/// Automation and AI Performance dashboards can show what the fleet is actually
/// doing — which agents fail, how long each takes, and where a run stopped.
/// Without this the agent architecture is unobservable, and an agent degrading
/// silently looks identical to one working.
model AgentRun {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  org        Organization @relation(fields: [orgId], references: [id])
  /// The extraction run this belonged to, when there was one.
  runId      String?  @map("run_id")
  /// The lead this execution touched, when the candidate survived long enough
  /// to become one. Null for a candidate an earlier agent rejected (discovery
  /// dead-end, verification failure) — there is no lead to attach that run to.
  leadId     String?  @map("lead_id")
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agent      String
  status     String
  durationMs Int      @map("duration_ms")
  attempts   Int      @default(1)
  error      String?
  notes      Json     @default("[]")
  startedAt  DateTime @default(now()) @map("started_at")

  @@index([orgId, startedAt])
  @@index([orgId, agent, status])
  @@index([leadId, startedAt])
  @@map("agent_runs")
}

/// The analytics/learning agents' latest output, persisted so it survives a
/// page reload instead of living only in the browser's React state until the
/// next "Run analysis" click. One row per org — each run overwrites the
/// last, since this is "what should we do next", not a growing history.
model AiInsightSnapshot {
  id                String   @id @default(uuid())
  orgId             String   @unique @map("org_id")
  org               Organization @relation(fields: [orgId], references: [id])
  generatedAt       DateTime @default(now()) @map("generated_at")
  insights          Json     @default("{}")
  recommendations   Json     @default("{}")
  /// Copy-level feedback tied to real sent-email excerpts (opened-without-
  /// reply vs. replied), not just aggregate rates — see LearningAgent.
  emailImprovements Json     @default("[]") @map("email_improvements")

  @@map("ai_insight_snapshots")
}

model Lead {
  id                  String   @id @default(uuid())
  orgId               String   @map("org_id")
  org                 Organization @relation(fields: [orgId], references: [id])
  runId               String?  @map("run_id")
  run                 ExtractionRun? @relation(fields: [runId], references: [id])
  filterId            String?  @map("filter_id")
  filter              NicheFilter? @relation(fields: [filterId], references: [id])
  campaignId          String?  @map("campaign_id")
  campaign            Campaign? @relation(fields: [campaignId], references: [id])
  assignedUserId       String?  @map("assigned_user_id")
  assignedUser         User?    @relation("AssignedUser", fields: [assignedUserId], references: [id])

  companyName         String   @map("company_name")
  /// Which method found this lead. Set once at creation, never changed after.
  sourceLayer         LeadSourceLayer @default(SURFACE_WEB) @map("source_layer")
  // Normalised forms used ONLY for duplicate detection, written on insert.
  // Comparing normalised values has to happen in the database, so the
  // normalisation must be persisted — computing it in TypeScript and then
  // querying on the raw column silently defeats itself.
  companyNameKey      String?  @map("company_name_key")
  linkedinSlug        String?  @map("linkedin_slug")
  website             String?
  websiteDomain       String?  @map("website_domain")
  linkedinUrl         String?  @map("linkedin_url")
  contactName         String?  @map("contact_name")
  jobTitle            String?  @map("job_title")
  email               String?
  personalEmail       String?  @map("personal_email")
  phone               String?
  industry            String?
  subNiche            String?  @map("sub_niche")
  country             String?
  city                String?
  companySize         String?  @map("company_size")
  revenueBand         String?  @map("revenue_band")
  employeeCount       Int?     @map("employee_count")
  techStack           Json     @default("[]") @map("tech_stack")
  businessModel       String?  @map("business_model")
  b2bOrB2c            String?  @map("b2b_or_b2c")
  businessDescription String?  @map("business_description")
  currentCrm          String?  @map("current_crm")

  // Contact's own LinkedIn, distinct from `linkedinUrl` above which is the
  // company page. Conflating the two loses the ability to research the person.
  contactLinkedinUrl  String?  @map("contact_linkedin_url")
  estimatedRevenue    String?  @map("estimated_revenue")
  websitePlatform     String?  @map("website_platform")
  automationTools     Json     @default("[]") @map("automation_tools")
  aiUsage             String?  @map("ai_usage")

  // Business intelligence gathered during discovery. Stored on the lead rather
  // than only in the review note, because these come from the AI's research and
  // exist before any human review — the reviewer edits them, they aren't
  // reviewer-authored.
  growthSignals           Json   @default("[]") @map("growth_signals")
  painPoints              String? @map("pain_points")
  aiOpportunities         String? @map("ai_opportunities")
  automationOpportunities String? @map("automation_opportunities")
  // Free-text evidence for what the finder claimed, so a reviewer can audit it.
  researchEvidence        String? @map("research_evidence")

  // Company Intelligence Agent output.
  swotAnalysis            Json    @default("{}") @map("swot_analysis")
  competitors             Json    @default("[]")
  recentNews              Json    @default("[]") @map("recent_news")
  marketingStack          Json    @default("[]") @map("marketing_stack")

  // Website Audit Agent output. Kept on the lead rather than only in the score
  // because a reviewer quotes these back to the prospect — they are evidence,
  // not just inputs to a number.
  uxIssues                String? @map("ux_issues")
  seoIssues               String? @map("seo_issues")

  // Buyer Intelligence Agent output.
  buyerPersona            String? @map("buyer_persona")

  verifiedEmail       Boolean  @default(false) @map("verified_email")
  verifiedLinkedin    Boolean  @default(false) @map("verified_linkedin")
  verifiedWebsite     Boolean  @default(false) @map("verified_website")
  possibleDuplicate   Boolean  @default(false) @map("possible_duplicate")

  createdAt           DateTime @default(now()) @map("created_at")
  lastActivityAt      DateTime? @map("last_activity_at")

  score               LeadScore?
  reviewNote          ReviewNote?
  agentReview         AgentReview?
  pipelineState       PipelineState?
  emailMessages       EmailMessage[]
  linkedinActivities  LinkedinActivity[]
  clickupSync         ClickupSync?
  sheetsSync          SheetsSync?
  auditLogs           AuditLog[]
  /// Every agent execution attributable to this lead, in run order — the
  /// per-lead trail behind the Automation dashboard's aggregate view.
  agentRuns           AgentRun[]
  notifications       Notification[]
  inboundEmailThreads InboundEmailThread[]

  // Tier-1 exact-match dedup (Part C2) — unique per org on domain and email.
  @@unique([orgId, websiteDomain], name: "org_domain_unique")
  @@unique([orgId, email], name: "org_email_unique")
  @@index([orgId, industry])
  @@index([orgId, createdAt])
  // These four were hand-written SQL in earlier migrations and never declared
  // here, so a later `prisma migrate dev` read their absence as drift and
  // silently dropped them (2026-07-29 incident — recovered same day). Declaring
  // them is what stops that happening again: duplicate checks run on every
  // lead insert and must not be sequential scans.
  @@index([campaignId], map: "leads_campaign_id_idx")
  @@index([orgId, companyNameKey], map: "leads_org_company_name_key_idx")
  @@index([orgId, linkedinSlug], map: "leads_org_linkedin_slug_idx")
  @@index([orgId, linkedinUrl], map: "leads_org_linkedin_url_idx")
  @@map("leads")
}

model LeadScore {
  id                    String   @id @default(uuid())
  leadId                String   @unique @map("lead_id")
  lead                  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadScore             Int      @map("lead_score")
  confidenceScore       Int      @map("confidence_score")
  aiOpportunityScore    Int      @map("ai_opportunity_score")
  automationScore       Int      @map("automation_score")
  crmReadinessScore     Int      @map("crm_readiness_score")
  websiteQualityScore   Int      @map("website_quality_score")

  // The scoring rubric's remaining dimensions. Kept as separate columns rather
  // than folded into leadScore so a reviewer can see *why* a lead ranked where
  // it did — a single opaque number is not reviewable, and reviewer feedback is
  // what the scoring loop is meant to improve on.
  businessFitScore      Int?     @map("business_fit_score")
  buyingIntentScore     Int?     @map("buying_intent_score")
  budgetScore           Int?     @map("budget_score")
  technologyGapScore    Int?     @map("technology_gap_score")
  decisionMakerAccessScore Int?  @map("decision_maker_access_score")
  // Weighted roll-up of the six dimensions; what the pipeline sorts on.
  leadPriorityScore     Int?     @map("lead_priority_score")

  // Maturity scores from the Company Intelligence Agent, and buyer scores from
  // the Buyer Intelligence Agent. Separate from the six rubric dimensions
  // because they describe the company and the person, not the fit of the deal.
  digitalMaturityScore      Int?  @map("digital_maturity_score")
  aiReadinessScore          Int?  @map("ai_readiness_score")
  automationOpportunityScore Int? @map("automation_opportunity_score")
  authorityScore            Int?  @map("authority_score")
  engagementScore           Int?  @map("engagement_score")
  projectComplexity         String? @map("project_complexity")
  fitReason             String?  @map("fit_reason")
  suggestedServices     String?  @map("suggested_services")
  expectedValue         Decimal? @map("expected_value")
  priority              Priority?
  scoredAt              DateTime @default(now()) @map("scored_at")

  // The pipeline ranks by priority score, so make that ordering cheap. Was
  // hand-written SQL (DESC NULLS LAST) never declared here, and got silently
  // dropped by a later `prisma migrate dev` for the same reason as the Lead
  // indexes above (2026-07-29 incident). Prisma can't express NULLS LAST, so
  // this recreates it DESC only — still avoids a sort node for the common
  // case, though nulls (unscored leads) sort first rather than last.
  @@index([leadPriorityScore(sort: Desc)], map: "lead_scores_lead_priority_score_idx")
  @@map("lead_scores")
}

model ReviewNote {
  id                       String   @id @default(uuid())
  leadId                   String   @unique @map("lead_id")
  lead                     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reviewerId               String?  @map("reviewer_id")
  reviewer                 User?    @relation(fields: [reviewerId], references: [id])
  websiteIssues            String?  @map("website_issues")
  businessProblems         String?  @map("business_problems")
  opportunities            String?
  automationOpportunities  String?  @map("automation_opportunities")
  crmIssues                String?  @map("crm_issues")
  salesIssues              String?  @map("sales_issues")
  marketingIssues          String?  @map("marketing_issues")
  operationalIssues        String?  @map("operational_issues")
  suggestedService         String?  @map("suggested_service")
  suggestedOffer           String?  @map("suggested_offer")
  suggestedCaseStudy       String?  @map("suggested_case_study")
  suggestedHook            String?  @map("suggested_hook")
  painPoints               String?  @map("pain_points")
  urgencyLevel             UrgencyLevel? @map("urgency_level")
  expectedValue            Decimal? @map("expected_value")
  notes                    String?
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("review_notes")
}

/// The AI's own counterpart to ReviewNote above — same fields, but synthesised
/// by the `agent_review` agent from what the intelligence/scoring agents found
/// rather than typed by a person. Gives a reviewer a populated starting point
/// (agree, correct, or override) instead of a blank form, and is what a
/// manually-added lead gets in place of a human's review until one happens.
model AgentReview {
  id                       String   @id @default(uuid())
  leadId                   String   @unique @map("lead_id")
  lead                     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  websiteIssues            String?  @map("website_issues")
  businessProblems         String?  @map("business_problems")
  opportunities            String?
  automationOpportunities  String?  @map("automation_opportunities")
  crmIssues                String?  @map("crm_issues")
  salesIssues              String?  @map("sales_issues")
  marketingIssues          String?  @map("marketing_issues")
  operationalIssues        String?  @map("operational_issues")
  suggestedService         String?  @map("suggested_service")
  suggestedOffer           String?  @map("suggested_offer")
  suggestedCaseStudy       String?  @map("suggested_case_study")
  suggestedHook            String?  @map("suggested_hook")
  painPoints               String?  @map("pain_points")
  urgencyLevel             UrgencyLevel? @map("urgency_level")
  expectedValue            Decimal? @map("expected_value")
  notes                    String?
  generatedAt              DateTime @default(now()) @map("generated_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("agent_reviews")
}

model PipelineState {
  leadId          String   @id @map("lead_id")
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage           PipelineStage @default(NEW_LEAD)
  enteredStageAt  DateTime @default(now()) @map("entered_stage_at")
  nextActionAt    DateTime? @map("next_action_at")
  // BullMQ delayed-job id for the pending wait-timer (Part C6). Lets the
  // sequencer cancel an in-flight "wait 2 days" job the instant a reply or
  // manual stage change makes it moot, instead of letting it fire anyway.
  waitJobId       String?  @map("wait_job_id")
  // One level of undo: the stage this lead was in immediately before the
  // current one. "Back" swaps stage<->previousStage rather than replaying full
  // history, which is enough for correcting a wrong drag or retrying a stage
  // whose automation failed (e.g. no mailbox configured yet) without needing a
  // separate retry mechanism.
  previousStage   PipelineStage? @map("previous_stage")

  @@map("pipeline_states")
}

model EmailAccount {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  org          Organization @relation(fields: [orgId], references: [id])
  provider     EmailProvider
  address      String   @unique
  /// Shown as the From display name in the recipient's inbox (e.g. "EurosHub
  /// Sales" instead of the bare mailbox address). Falls back to the org-wide
  /// sender name (Settings > Email branding) when unset.
  displayName  String?  @map("display_name")
  dailyLimit   Int      @default(30) @map("daily_limit")
  hourlyLimit  Int      @default(5) @map("hourly_limit")
  warmupActive Boolean  @default(true) @map("warmup_active")
  status       EmailAccountStatus @default(ACTIVE)
  /// Explicit opt-in for the outbound rotation (EmailProviderService.
  /// pickAvailableAccount) — `status: ACTIVE` alone used to be enough to be
  /// picked, which meant a mailbox added only for reading (or added before
  /// its send credentials were entered) could get swept into sending real
  /// campaign emails the moment it existed. Confirmed live: an unconfigured
  /// mailbox got picked, silently "succeeded" (see the stub-send fix in
  /// SmtpProvider/GmailProvider), and a lead's whole sequence was marked
  /// SENT with nothing ever delivered. Defaults false — an admin must
  /// explicitly turn this on per mailbox now.
  sendingEnabled Boolean @default(false) @map("sending_enabled")
  createdAt    DateTime @default(now()) @map("created_at")

  // GMAIL: OAuth2 refresh token for this mailbox (gmail.send + gmail.readonly
  // scopes — Part G1). Obtained out-of-band via a one-time consent flow, not
  // stored in .env since it's per-mailbox, not per-deployment.
  // Encrypted at rest (EncryptionService) since the Email Hub migration —
  // EmailAccountsService.EncryptionService.looksEncrypted() distinguishes a
  // still-plaintext legacy value from a real ciphertext on read, so no
  // separate backfill migration is required before this can ship.
  oauthRefreshToken String? @map("oauth_refresh_token")
  // Cursor into Gmail's history API (Part E2 gmail webhook) — lets the push
  // adapter fetch only what changed since the last processed notification
  // instead of replaying the whole mailbox history on every event. Unused
  // until the Phase 2 Gmail-API push reader ships; the Email Hub's own V1
  // sync (IMAP, see lastImapUid below) doesn't touch this.
  lastHistoryId     String? @map("last_history_id")

  // MICROSOFT_365 / SMTP: plain SMTP AUTH credentials, used for *sending*.
  // Encrypted at rest since the Email Hub migration (see oauthRefreshToken
  // comment above for the legacy-plaintext transition note).
  smtpHost     String? @map("smtp_host")
  smtpPort     Int?    @map("smtp_port")
  smtpUsername String? @map("smtp_username")
  smtpPassword String? @map("smtp_password")

  // ---- Email Hub: inbound IMAP sync (Part: Email Hub V1) ----
  // A mailbox can be sent-from (above), read via IMAP (below), or both —
  // most accounts will be both, but e.g. a pure notification mailbox might
  // only ever be read. Kept on the same row rather than a separate model:
  // one EmailAccount is still one mailbox, just capable of more now.
  imapHost           String?  @map("imap_host")
  imapPort           Int?     @map("imap_port")
  /// "SSL" | "STARTTLS" | "NONE"
  imapEncryption     String?  @map("imap_encryption")
  imapUsername       String?  @map("imap_username")
  /// Encrypted at rest (EncryptionService) — never plaintext, unlike the
  /// legacy smtpPassword/oauthRefreshToken columns above.
  imapPasswordEnc    String?  @map("imap_password_enc")
  /// IMAP UID of the last message the sync worker has already processed for
  /// this account's INBOX — the poll cursor. Null means "never synced yet."
  lastImapUid        Int?     @map("last_imap_uid")
  /// Internal display name for this mailbox in the Email Hub UI — distinct
  /// from `displayName` above, which is the outbound From name a *recipient*
  /// sees. Falls back to `address` when unset.
  mailboxLabel       String?  @map("mailbox_label")
  /// Whether the sync worker should poll this account at all — off by
  /// default so adding sending-only credentials never silently starts an
  /// inbox sync nobody asked for.
  inboundSyncEnabled Boolean  @default(false) @map("inbound_sync_enabled")

  emailMessages   EmailMessage[]
  inboundThreads  InboundEmailThread[]
  inboundMessages InboundEmailMessage[]
  accessGrants    EmailAccountAccess[]

  @@map("email_accounts")
}

model EmailMessage {
  id            String   @id @default(uuid())
  leadId        String   @map("lead_id")
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  accountId     String?  @map("account_id")
  account       EmailAccount? @relation(fields: [accountId], references: [id])
  sequenceStep  Int      @map("sequence_step")
  subject       String
  bodyHtml      String   @map("body_html")
  rationale     Json?
  generatedBy   GeneratedBy @map("generated_by")
  status        EmailMessageStatus @default(DRAFT)
  scheduledAt   DateTime? @map("scheduled_at")
  sentAt        DateTime? @map("sent_at")
  /// When this row was drafted — the only reliable proxy for "which queued
  /// email sends first" (the email-send BullMQ queue has no delay and
  /// processes FIFO, so draft order is send order). `scheduledAt` above and
  /// EmailEventType.QUEUED both look like they'd answer this but neither is
  /// ever written anywhere in the codebase.
  createdAt     DateTime @default(now()) @map("created_at")
  /// Why this send permanently failed (ComplianceGateError message, e.g. "Lead
  /// has no verified email address") or why every retry was exhausted — set by
  /// EmailSendWorker at the moment of failure. Without this, a FAILED row gave
  /// no way to tell "recipient unsubscribed" from "no email on file" from a
  /// transient SMTP error apart from reading server logs by hand.
  failureReason String? @map("failure_reason")

  events        EmailEvent[]

  @@index([leadId])
  @@map("email_messages")
}

model EmailEvent {
  id         String   @id @default(uuid())
  messageId  String   @map("message_id")
  message    EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  eventType  EmailEventType @map("event_type")
  occurredAt DateTime @default(now()) @map("occurred_at")
  meta       Json     @default("{}")

  @@map("email_events")
}

// ============================================================================
// Email Hub (V1): a provider-independent unified inbox across every
// EmailAccount, kept fully separate from the outbound-sending models above
// (EmailMessage/EmailEvent are lead-scoped, sequence-driven sends — inbound
// mail has none of those constraints: no lead may exist yet, no sequence
// step, arbitrary senders, folders, and per-message flags a human sets).
// ============================================================================

/// One conversation in one mailbox — messages are grouped into a thread by
/// Message-ID/References/In-Reply-To headers (falling back to a normalized
/// subject when a provider omits them), same idea as any email client's
/// "conversation view."
model InboundEmailThread {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  org           Organization @relation(fields: [orgId], references: [id])
  accountId     String   @map("account_id")
  account       EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subject       String
  /// [{name, email}] snapshot of everyone on the thread — denormalized so the
  /// unified-inbox list can render "From" without a join per row across
  /// what may be thousands of threads.
  participants  Json     @default("[]")
  /// Set once a human clicks "Add to Lead," or automatically when a reply
  /// arrives from an address that matches an existing lead (Part: Lead
  /// Integration) — reuses LeadsService.findExistingDuplicate, never creates
  /// a second lead for the same person.
  leadId        String?  @map("lead_id")
  lead          Lead?    @relation(fields: [leadId], references: [id])
  lastMessageAt DateTime @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  messages InboundEmailMessage[]

  @@index([orgId, accountId, lastMessageAt])
  @@index([orgId, leadId])
  @@map("inbound_email_threads")
}

/// One received message. Deliberately not merged into EmailMessage above —
/// see the section comment — even though both describe "an email that
/// touched this mailbox."
model InboundEmailMessage {
  id                String   @id @default(uuid())
  threadId          String   @map("thread_id")
  thread            InboundEmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  accountId         String   @map("account_id")
  account           EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The provider's own message id (IMAP UID today; Gmail API message id
  /// once the Phase 2 reader ships) — paired with accountId as the dedupe
  /// key so a sync retry or a re-poll of the same UID never inserts twice.
  providerMessageId String   @map("provider_message_id")
  /// RFC 5322 `Message-ID` header — the threading key a later message's
  /// `In-Reply-To`/`References` headers point back to. Not every message has
  /// one (some providers omit it); threading falls back to normalized
  /// subject when absent. See EmailHubSyncWorker.findOrCreateThreadId.
  messageIdHeader   String?  @map("message_id_header")
  fromName          String?  @map("from_name")
  fromEmail         String   @map("from_email")
  toEmails          String[] @map("to_emails")
  ccEmails          String[] @map("cc_emails")
  bccEmails         String[] @map("bcc_emails")
  subject           String
  bodyText          String   @map("body_text")
  bodyHtml          String?  @map("body_html")
  receivedAt        DateTime @map("received_at")
  folder            String   @default("INBOX")
  isRead            Boolean  @default(false) @map("is_read")
  isImportant       Boolean  @default(false) @map("is_important")
  /// Removed from the working inbox view without touching the real mailbox
  /// (Part: Ignore/Noise Management) — a filter flag, never a delete.
  isIgnored         Boolean  @default(false) @map("is_ignored")
  hasAttachments    Boolean  @default(false) @map("has_attachments")
  /// [{filename, size, contentId}] — metadata only; attachment bytes are
  /// fetched from the mailbox on demand when a human opens one, not stored
  /// here, so a sync never has to move large binaries through Postgres.
  attachments       Json     @default("[]")
  /// AI-ready, unpopulated in V1 (Part: Smart Email Classification) — a
  /// future classification agent writes a suggestion here; nothing reads or
  /// acts on it automatically. See aiSuggestedAction below for the same
  /// contract applied to a proposed next action rather than a category.
  suggestedCategory String?  @map("suggested_category")
  aiSuggestedAction String?  @map("ai_suggested_action")
  createdAt         DateTime @default(now()) @map("created_at")
  /// GENERATED ALWAYS AS (...) STORED column added by raw SQL in this
  /// model's migration — Prisma has no native tsvector type, so it's
  /// declared Unsupported (excluded from the generated client, never
  /// written by application code) purely so `prisma migrate dev` doesn't
  /// read it as drift and try to drop it on a future migration.
  searchVector      Unsupported("tsvector")? @map("search_vector")

  tags InboundEmailMessageTag[]

  @@unique([accountId, providerMessageId])
  @@index([threadId])
  @@index([accountId, isRead])
  @@index([accountId, isIgnored])
  @@index([accountId, messageIdHeader])
  @@index([accountId, suggestedCategory])
  @@map("inbound_email_messages")
}

/// User-defined, never hardcoded (Part: Email Tags) — an org creates its own
/// tag vocabulary from Settings or inline while tagging a message.
model EmailTag {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  color     String   @default("#6b7280")
  createdAt DateTime @default(now()) @map("created_at")

  messages InboundEmailMessageTag[]

  @@unique([orgId, name])
  @@map("email_tags")
}

model InboundEmailMessageTag {
  messageId String   @map("message_id")
  message   InboundEmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tagId     String   @map("tag_id")
  tag       EmailTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([messageId, tagId])
  @@map("inbound_email_message_tags")
}

/// Account-level permission grant (Part: User Access & Permissions) — an
/// ADMIN implicitly sees every account with no row needed here; a
/// non-admin's Email Hub queries are scoped to exactly the accounts they
/// have a grant for. Absence of a row means no access, not "view-only."
model EmailAccountAccess {
  userId    String   @map("user_id")
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String   @map("account_id")
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  canReply  Boolean  @default(true) @map("can_reply")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, accountId])
  @@map("email_account_access")
}

model LinkedinActivity {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  status    LinkedinStatus @default(NOT_STARTED)
  /// AI-drafted connectionNote/followUpMessage/secondFollowUp for a human to
  /// copy and send manually — LinkedIn automation itself stays out of scope
  /// (ToS/ban risk). Null until "Generate LinkedIn copy" has been used once.
  draftMessages Json?  @map("draft_messages")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("linkedin_activities")
}

model ClickupSync {
  leadId        String   @id @map("lead_id")
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clickupTaskId String   @map("clickup_task_id")
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at")

  @@map("clickup_syncs")
}

model SheetsSync {
  leadId       String   @id @map("lead_id")
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rowNumber    Int      @map("row_number")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  @@map("sheets_syncs")
}

enum CaseStudyStatus {
  /// Submitted, waiting on (or mid-) AI review — never matched for a real send
  /// (see SequencerService.dispatchEmailDraft's `status: READY` filter), so a
  /// draft still being reviewed can never reach a prospect.
  PENDING_REVIEW
  READY
  /// The review agent couldn't run (Claude CLI unavailable) or produced
  /// nothing usable — the raw submission is kept, but excluded from sends
  /// the same as PENDING_REVIEW, and surfaced in Settings for a retry.
  NEEDS_ATTENTION
}

model CaseStudy {
  id       String   @id @default(uuid())
  orgId    String   @map("org_id")
  org      Organization @relation(fields: [orgId], references: [id])

  /// Finalised by the review agent — what Email 3 ("Proof") actually reads.
  /// Starts as a copy of the raw submission and is only ever tightened for
  /// email use, never expanded with anything the raw story didn't say (see
  /// shared/prompts/case_study_review.txt's hard rule against inventing
  /// numbers).
  industry String
  title    String
  summary  String
  metrics  Json     @default("{}")
  status   CaseStudyStatus @default(PENDING_REVIEW)

  /// The operator's own words, preserved verbatim — what the review agent
  /// actually read, and what a re-review re-reads if the org edits the
  /// niche or asks for another pass. Never shown to a prospect directly.
  rawStory          String
  /// What the submitter picked in the niche dropdown — kept even if the
  /// review agent's `industry` above ends up different, so the mismatch
  /// itself (visible in Settings) is evidence, not silently overwritten.
  submittedIndustry String @map("submitted_industry")
  /// The review agent's own account of what it changed or flagged — shown
  /// in Settings so "why does this say a different niche than I picked" or
  /// "why is this still Needs attention" has a real answer, not a guess.
  reviewNotes       String? @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orgId, industry])
  @@map("case_studies")
}

// Cross-sequence suppression list (Part C6 / I4 / I5) — checked before every
// single send, not just at sequence start. Populated from unsubscribe clicks,
// hard bounces, spam complaints, and manual do-not-contact entries.
model SuppressionEntry {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id])
  email     String
  reason    String // UNSUBSCRIBED | HARD_BOUNCE | SPAM_COMPLAINT | MANUAL
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orgId, email])
  @@map("suppression_entries")
}

model AuditLog {
  id        String   @id @default(uuid())
  leadId    String?  @map("lead_id")
  // SetNull rather than the default: deleting a lead must keep the audit
  // trail entry (who did what, when) even though the row it was about is
  // gone — losing accountability history is worse than an orphaned reference.
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  diff      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("audit_logs")
}

/// Surfaced when automatic recovery fails and a human genuinely needs to
/// know — an agent-dispatch job exhausting its retries, a pipeline hitting a
/// permanent failure. Everyday agent activity (OK/DEGRADED runs, normal
/// stage transitions) does NOT create one of these; that's what AgentRun and
/// the live event stream are for. A Notification means "autonomous recovery
/// could not fix this on its own."
model Notification {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id])
  leadId    String?  @map("lead_id")
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  /// Set for Social Inbox notifications (new message, assignment) — parallel
  /// to leadId above, same "optional FK per entity type this can be about"
  /// shape rather than a polymorphic target.
  conversationId String?  @map("conversation_id")
  conversation   SocialConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  type      String
  severity  String   @default("ERROR") // ERROR | WARNING
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId, read, createdAt])
  @@map("notifications")
}

// ============================================================================
// Social Media Management (V1): connect multiple accounts per platform,
// compose platform-specific content, schedule/approve/publish, with a
// provider abstraction so a platform with no real connection yet still
// gets an honest UI state instead of a fake one. See
// SocialPlatformProvider (src/social-media/providers) for the capability
// registry every platform declares truthfully.
// ============================================================================

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  WHATSAPP
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
  ERROR
}

enum SocialPostStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  REJECTED
}

model SocialAccount {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  org               Organization @relation(fields: [orgId], references: [id])
  platform          SocialPlatform
  /// The platform's own account id, set once a real connection exists —
  /// null for an account row created ahead of connecting (Part: Add
  /// Account lets you configure defaults before OAuth even runs).
  externalAccountId String?  @map("external_account_id")
  /// Handle/username, e.g. "@brand1" — required even pre-connection since
  /// it's how a human tells accounts on the same platform apart.
  username          String
  /// Internal label, distinct from the platform-reported name — same
  /// "mailboxLabel" idea as EmailAccount.
  displayName       String?  @map("display_name")
  profileImageUrl   String?  @map("profile_image_url")
  /// "business" | "personal" | "page" — platform-reported once connected,
  /// operator-guessed before that; free text since each platform's own
  /// vocabulary differs (Instagram "business/creator" vs LinkedIn "page").
  accountType       String?  @map("account_type")
  status            SocialAccountStatus @default(DISCONNECTED)
  /// Encrypted at rest (EncryptionService) — same convention as
  /// EmailAccount's credential columns, never plaintext.
  accessTokenEnc    String?  @map("access_token_enc")
  refreshTokenEnc   String?  @map("refresh_token_enc")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  connectedByUserId String?  @map("connected_by_user_id")
  connectedAt       DateTime? @map("connected_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  defaultTimezone   String?  @map("default_timezone")
  defaultHashtags   String[] @default([]) @map("default_hashtags")
  defaultCta        String?  @map("default_cta")
  brandVoice        String?  @map("brand_voice")
  /// Whether a post targeting this account must pass PENDING_REVIEW before
  /// it can be scheduled — Part: Approval Workflow, per-account since
  /// different brands/accounts may need different rigor.
  approvalRequired  Boolean  @default(true) @map("approval_required")
  createdAt         DateTime @default(now()) @map("created_at")

  accessGrants  SocialAccountAccess[]
  postVersions  SocialPostVersion[]
  conversations SocialConversation[]

  /// One row per (platform, handle) per org — reconnecting the same
  /// account edits this row rather than creating a duplicate.
  @@unique([orgId, platform, username])
  @@map("social_accounts")
}

/// Account-level permission grant — same shape and same "absence means no
/// access, not read-only" contract as EmailAccountAccess.
model SocialAccountAccess {
  userId     String  @map("user_id")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String  @map("account_id")
  account    SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Gates whether this account's conversations show up in the user's
  /// Social Inbox filter (Part: Unified Social Media DM Monitoring) —
  /// deliberately separate from canPublish/canApprove below, which gate
  /// the scheduling/calendar module instead. Defaults true on a new grant
  /// row: creating a grant at all already implies "this person should see
  /// this account," same reasoning canPublish/canApprove default false
  /// (an explicit elevated capability) while this one defaults open.
  canView    Boolean @default(true) @map("can_view")
  canPublish Boolean @default(false) @map("can_publish")
  canApprove Boolean @default(false) @map("can_approve")
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([userId, accountId])
  @@map("social_account_access")
}

// ----------------------------------------------------------------------
// Unified Social Media DM Monitoring (separate from the posting/calendar
// models above): connect once, monitor every connected account's inbound
// conversations from one place. Deliberately no lead/CRM linkage anywhere
// in this section — that's an explicit later-phase decision, not this one.
// ----------------------------------------------------------------------

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

/// One row per (account, external conversation) — populated by the Meta
/// webhook receiver and, as a reconciliation fallback, SocialInboxSyncWorker.
/// Never written to by anything in the Lead Generation module.
model SocialConversation {
  id                     String   @id @default(uuid())
  socialAccountId        String   @map("social_account_id")
  socialAccount          SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  externalConversationId String   @map("external_conversation_id")
  contactExternalId      String?  @map("contact_external_id")
  contactName            String?  @map("contact_name")
  contactUsername        String?  @map("contact_username")
  contactProfileImageUrl String?  @map("contact_profile_image_url")
  lastMessage            String?  @map("last_message")
  lastMessageAt          DateTime @map("last_message_at")
  unreadCount            Int      @default(0) @map("unread_count")
  status                 ConversationStatus @default(OPEN)
  assignedToUserId       String?  @map("assigned_to_user_id")
  assignedToUser         User?    @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  messages     SocialMessage[]
  notes        SocialInternalNote[]
  notifications Notification[]

  /// Dedup key — a webhook retry or the reconciliation poll re-observing
  /// the same platform conversation must resolve to this same row, not a
  /// duplicate (same reasoning as InboundEmailThread's identity).
  @@unique([socialAccountId, externalConversationId])
  @@index([lastMessageAt(sort: Desc)])
  @@index([status])
  @@index([assignedToUserId])
  @@index([unreadCount])
  @@map("social_conversations")
}

model SocialMessage {
  id                String   @id @default(uuid())
  conversationId    String   @map("conversation_id")
  conversation      SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalMessageId String   @map("external_message_id")
  /// true = we sent it (via the reply box), false = the contact sent it.
  /// Same field the provider's ConversationMessage.fromUs already reports —
  /// stored as-is rather than translated into a separate direction/
  /// sender_type pair that would just say the same thing twice.
  fromUs            Boolean  @map("from_us")
  senderName        String?  @map("sender_name")
  messageText       String?  @map("message_text")
  mediaUrl          String?  @map("media_url")
  sentAt            DateTime @map("sent_at")
  createdAt         DateTime @default(now()) @map("created_at")

  /// Dedup key — the same message re-delivered by a webhook retry or seen
  /// again by the reconciliation poll must not insert twice.
  @@unique([conversationId, externalMessageId])
  @@map("social_messages")
}

/// Team-only annotations on a conversation — never sent to the platform,
/// never rendered inside the message thread (Part: Internal Notes). Kept
/// as its own table rather than a message with a flag so there's no way
/// for a future bug to accidentally include one in an outbound payload.
model SocialInternalNote {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  conversation   SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  note           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([conversationId])
  @@map("social_internal_notes")
}

/// The logical post — one row regardless of how many accounts/platforms
/// it targets. Content itself lives on SocialPostVersion, one per
/// targeted account, since the spec explicitly forbids blindly
/// duplicating identical content across platforms.
model SocialPost {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  org              Organization @relation(fields: [orgId], references: [id])
  createdByUserId  String   @map("created_by_user_id")
  /// Optional link into the existing lead-gen Campaign entity, for
  /// cross-module reporting — new relation, no prior pattern to match
  /// (only Lead.campaignId existed before this).
  campaignId       String?  @map("campaign_id")
  campaign         Campaign? @relation(fields: [campaignId], references: [id])
  status           SocialPostStatus @default(DRAFT)
  scheduledAt      DateTime? @map("scheduled_at")
  timezone         String?
  /// {frequency, daysOfWeek, endDate} — null means one-off. Recurrence
  /// materializes concrete future SocialPost rows (Part: Recurring
  /// Posts) rather than being evaluated live, so each occurrence stays
  /// independently editable/skippable/cancellable.
  recurrenceRule   Json?    @map("recurrence_rule")
  approvedByUserId String?  @map("approved_by_user_id")
  approvedAt       DateTime? @map("approved_at")
  rejectionReason  String?  @map("rejection_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  versions SocialPostVersion[]
  media    SocialPostMedia[]

  @@index([orgId, status])
  @@index([orgId, scheduledAt])
  @@map("social_posts")
}

model SocialPostVersion {
  id             String   @id @default(uuid())
  postId         String   @map("post_id")
  post           SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Nullable so deleting a SocialAccount (Part: Settings > Social Accounts
  /// delete) doesn't get blocked by post history -- SetNull mirrors
  /// EmailAccountsService.remove's "keep the record, drop the link" pattern.
  /// The publish worker treats accountId === null as a permanent failure,
  /// never as "nothing to do".
  accountId      String?  @map("account_id")
  account        SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  content        String
  hashtags       String[] @default([])
  /// Set once actually published through the provider — the platform's
  /// own post id, for building a permalink / fetching performance later.
  externalPostId String?  @map("external_post_id")
  publishedAt    DateTime? @map("published_at")
  /// Why the last publish attempt failed (provider error, or "not
  /// connected" if the account has no real credentials yet) — Part:
  /// Failed Publishing's explicit "do not silently mark as published."
  publishError   String?  @map("publish_error")
  lastAttemptAt  DateTime? @map("last_attempt_at")

  @@unique([postId, accountId])
  @@map("social_post_versions")
}

model MediaAsset {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  org              Organization @relation(fields: [orgId], references: [id])
  uploadedByUserId String   @map("uploaded_by_user_id")
  folderId         String?  @map("folder_id")
  folder           MediaFolder? @relation(fields: [folderId], references: [id])
  filename         String
  /// Opaque locator MediaStorageService understands — a relative disk
  /// path in the V1 local implementation, an S3/R2 key if that's ever
  /// swapped in later. Never a full URL (that's derived, not stored).
  storageKey       String   @map("storage_key")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  tags             String[] @default([])
  createdAt        DateTime @default(now()) @map("created_at")

  posts SocialPostMedia[]

  @@index([orgId, folderId])
  @@map("media_assets")
}

model MediaFolder {
  id       String  @id @default(uuid())
  orgId    String  @map("org_id")
  org      Organization @relation(fields: [orgId], references: [id])
  name     String
  parentId String? @map("parent_id")

  assets MediaAsset[]

  @@map("media_folders")
}

model SocialPostMedia {
  postId  String @map("post_id")
  post    SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaId String @map("media_id")
  media   MediaAsset @relation(fields: [mediaId], references: [id])

  @@id([postId, mediaId])
  @@map("social_post_media")
}

/// Reusable, user-defined hashtag sets (Part: Hashtag / Content
/// Organization) — never hardcoded, same philosophy as EmailTag.
model HashtagGroup {
  id       String   @id @default(uuid())
  orgId    String   @map("org_id")
  org      Organization @relation(fields: [orgId], references: [id])
  name     String
  hashtags String[]
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orgId, name])
  @@map("hashtag_groups")
}

/// Reusable post starting points (Part: Content Templates) — "Product
/// Announcement," "Testimonial," etc. `bodyTemplate` is plain text with
/// placeholders a human fills in, not executable.
model ContentTemplate {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  org          Organization @relation(fields: [orgId], references: [id])
  name         String
  category     String
  bodyTemplate String   @map("body_template")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("content_templates")
}

/// WHEN this happens -> DO this (Part: Social Media Automations). V1
/// only ever sets/reads triggerType = "NEW_LEAD" — the one trigger that
/// maps to something real in this codebase (Lead creation). Other
/// trigger types described in the spec (e.g. "new blog published") have
/// no source module to fire from yet, so they're not represented here
/// rather than being faked.
model SocialAutomation {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  org             Organization @relation(fields: [orgId], references: [id])
  name            String
  triggerType     String   @map("trigger_type")
  conditions      Json     @default("{}")
  /// [{type: "CREATE_DRAFT", platforms: [...], templateId?}, {type:
  /// "NOTIFY", userId}] — a short, fixed action vocabulary, not a
  /// scripting language.
  actions         Json
  active          Boolean  @default(true)
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  runs SocialAutomationRun[]

  @@map("social_automations")
}

/// One row per time an automation actually fired — the execution log a
/// human can audit ("why did this draft appear").
model SocialAutomationRun {
  id           String   @id @default(uuid())
  automationId String   @map("automation_id")
  automation   SocialAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  /// Free-text reference to whatever triggered this (e.g. a Lead id) —
  /// not a hard FK, since the whole point of the trigger vocabulary is to
  /// grow to sources this table shouldn't need to know about individually.
  triggerRef   String?  @map("trigger_ref")
  status       String   // OK | FAILED
  resultNote   String?  @map("result_note")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("social_automation_runs")
}

/// Dedicated audit trail for this module — NOT the existing global
/// AuditLog, which is hard-wired to a lead-only FK via a blanket
/// interceptor (confirmed by reading audit-log.interceptor.ts) and has
/// no field to hang a social-post reference off of. Written explicitly
/// at the points that matter (approve, reject, publish, connect/
/// disconnect), not on every mutating request.
model SocialAuditLog {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  actorId   String?  @map("actor_id")
  action    String
  postId    String?  @map("post_id")
  accountId String?  @map("account_id")
  diff      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@map("social_audit_logs")
}
