// Prisma schema — implements the ERD in Part B4 of lead-gen-system-architecture.md
generator client {
  provider = "prisma-client-js"
  // "native" covers the developer's own machine. The musl target is required
  // for the Alpine-based container image: Prisma's default `linux-musl` engine
  // links against libssl.so.1.1, but Alpine 3.19+ (what node:20-alpine is built
  // on) ships OpenSSL 3.x, so the container booted straight into
  // "Error loading shared library libssl.so.1.1". Without this line the image
  // builds fine and only fails at runtime, which is the worst place to find out.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  LEAD_REVIEWER
  SALES_REP
  VIEWER
}

// Declaration order is funnel order — see the note on the shared PipelineStage
// enum in packages/types/src/enums.ts.
enum PipelineStage {
  NEW_LEAD
  VERIFIED
  RESEARCH_COMPLETED
  UNDER_REVIEW
  READY_FOR_OUTREACH
  EMAIL_1_SENT
  WAITING_EMAIL_2
  EMAIL_2_SENT
  WAITING_EMAIL_3
  EMAIL_3_SENT
  WAITING_EMAIL_4
  EMAIL_4_SENT
  WAITING_EMAIL_5
  EMAIL_5_SENT
  LINKEDIN_OUTREACH
  LINKEDIN_FOLLOW_UP
  REPLIED
  MEETING_BOOKED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  CLIENT_ONBOARDING
  LOST
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

/// Where a lead's data actually came from. No "dark web" value on purpose —
/// see the doc comment on the shared TS enum (@leadgen/types) for why.
enum LeadSourceLayer {
  SURFACE_WEB
  LICENSED_DATABASE
  MANUAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ExtractionRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_SHORT_OF_TARGET
  FAILED
  CANCELLED
}

enum EmailProvider {
  GMAIL
  MICROSOFT_365
  SMTP
}

enum EmailAccountStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum EmailMessageStatus {
  DRAFT
  PENDING_APPROVAL
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum GeneratedBy {
  TEMPLATE
  CLAUDE
  GEMINI
  HUMAN_EDIT
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  SPAM_COMPLAINT
  UNSUBSCRIBED
  BLOCKED
  FAILED
}

enum LinkedinStatus {
  NOT_STARTED
  CONNECTION_SENT
  ACCEPTED
  MESSAGE_SENT
  REPLIED
  MEETING_SCHEDULED
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  settings     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  users        User[]
  nicheFilters NicheFilter[]
  leads        Lead[]
  emailAccounts EmailAccount[]
  caseStudies  CaseStudy[]
  suppressionEntries SuppressionEntry[]
  agentRuns    AgentRun[]
  campaigns    Campaign[]
  notifications Notification[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id])
  email     String   @unique
  name      String
  passwordHash String  @map("password_hash")
  role      Role     @default(VIEWER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  assignedLeads Lead[] @relation("AssignedUser")
  reviewNotes   ReviewNote[]
  linkedinActivities LinkedinActivity[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  revoked    Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model NicheFilter {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  org            Organization @relation(fields: [orgId], references: [id])
  niche          String
  subNiche       String?  @map("sub_niche")
  countries      String[] @default([])
  cities         String[] @default([])
  companySizeMin Int?     @map("company_size_min")
  companySizeMax Int?     @map("company_size_max")
  revenueBandMin String?  @map("revenue_band_min")
  revenueBandMax String?  @map("revenue_band_max")
  employeeCountMin Int?   @map("employee_count_min")
  employeeCountMax Int?   @map("employee_count_max")
  jobTitles      String[] @default([])
  technologies   String[] @default([])
  fundingStage   String?  @map("funding_stage")
  businessModel  String?  @map("business_model")
  b2bOrB2c       String?  @map("b2b_or_b2c")

  // Targeting filters. Values are constrained to the catalogues in
  // packages/types/src/filter-taxonomy.ts, which the DTO validates against and
  // the settings UI renders — one source of truth for all three consumers.
  //
  // Every array defaults to empty, and empty means "no constraint on this
  // dimension" rather than "match nothing". That distinction matters: these
  // columns are added to filters that already exist, and the opposite reading
  // would silently stop every current filter from returning any leads.
  companyTypes         String[] @default([]) @map("company_types")
  growthStages         String[] @default([]) @map("growth_stages")
  companyKeywords      String[] @default([]) @map("company_keywords")
  departments          String[] @default([])
  seniorityLevels      String[] @default([]) @map("seniority_levels")
  yearsInBusinessMin   Int?     @map("years_in_business_min")
  yearsInBusinessMax   Int?     @map("years_in_business_max")
  hiringSignals        String[] @default([]) @map("hiring_signals")
  websiteConditions    String[] @default([]) @map("website_conditions")
  aiOpportunitySignals String[] @default([]) @map("ai_opportunity_signals")

  // Exclusions, applied after every inclusion filter. A candidate matching any
  // of these is rejected however well it scores elsewhere.
  exclusionSignals  String[] @default([]) @map("exclusion_signals")
  excludeIndustries String[] @default([]) @map("exclude_industries")
  excludeKeywords   String[] @default([]) @map("exclude_keywords")
  excludeCompanies  String[] @default([]) @map("exclude_companies")

  dailyTarget    Int      @default(100) @map("daily_target")
  sourcePriority String[] @default([]) @map("source_priority")
  // Enrichment agents to skip for this filter (company_intelligence,
  // website_audit, buyer_intelligence — the only ones the worker will ever
  // drop; discovery/verification/opportunity/scoring ignore this). Cuts the
  // pipeline from 6 Claude CLI calls per candidate to 3.
  disabledAgents String[] @default([]) @map("disabled_agents")
  scheduleCron   String   @default("0 6 * * *") @map("schedule_cron")
  timezone       String   @default("UTC")
  active         Boolean  @default(true)
  // Part C5: one ClickUp List per niche filter — config, not a hardcoded ID.
  clickupListId  String?  @map("clickup_list_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  extractionRuns ExtractionRun[]
  leads          Lead[]
  campaigns      Campaign[]

  @@map("niche_filters")
}

model ExtractionRun {
  id                String   @id @default(uuid())
  filterId          String   @map("filter_id")
  filter            NicheFilter @relation(fields: [filterId], references: [id])
  startedAt         DateTime @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  leadsFound        Int      @default(0) @map("leads_found")
  leadsVerified     Int      @default(0) @map("leads_verified")
  duplicatesSkipped Int      @default(0) @map("duplicates_skipped")
  status            ExtractionRunStatus @default(RUNNING)
  // Why a FAILED run failed. Without it the dashboard can report that a run
  // broke but never what broke, which is the first thing an operator asks.
  error             String?
  /// Leads produced per priority band, for checking the 40/40/20 mix actually
  /// held. A run that hit its total but produced only high-priority leads has
  /// spent no exploration budget, and the targeting stops improving.
  priorityMix       Json     @default("{}") @map("priority_mix")

  leads             Lead[]

  @@map("extraction_runs")
}

/// A campaign groups a niche, an offer and a message sequence so performance
/// can be attributed. Without it "best offer" and "best sequence" are
/// unanswerable — every lead looks the same to analytics, and the learning loop
/// has nothing to compare against.
model Campaign {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  org           Organization @relation(fields: [orgId], references: [id])
  name          String
  niche         String
  country       String?
  /// What is being sold in this campaign, in the operator's own words. Feeds
  /// the email prompts, so it is a real input, not a label.
  offer         String?
  caseStudy     String?  @map("case_study")
  goal          String?
  targetLeads   Int      @default(100) @map("target_leads")
  /// Per-step subject/angle overrides. Empty means use the default sequence.
  emailSequence Json     @default("[]") @map("email_sequence")
  linkedinSequence Json  @default("[]") @map("linkedin_sequence")
  /// Optional niche filter that feeds this campaign.
  filterId      String?  @map("filter_id")
  filter        NicheFilter? @relation(fields: [filterId], references: [id])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  leads         Lead[]

  @@index([orgId, active])
  @@map("campaigns")
}

/// One agent execution. Written by the workers after every agent run so the
/// Automation and AI Performance dashboards can show what the fleet is actually
/// doing — which agents fail, how long each takes, and where a run stopped.
/// Without this the agent architecture is unobservable, and an agent degrading
/// silently looks identical to one working.
model AgentRun {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  org        Organization @relation(fields: [orgId], references: [id])
  /// The extraction run this belonged to, when there was one.
  runId      String?  @map("run_id")
  /// The lead this execution touched, when the candidate survived long enough
  /// to become one. Null for a candidate an earlier agent rejected (discovery
  /// dead-end, verification failure) — there is no lead to attach that run to.
  leadId     String?  @map("lead_id")
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agent      String
  status     String
  durationMs Int      @map("duration_ms")
  attempts   Int      @default(1)
  error      String?
  notes      Json     @default("[]")
  startedAt  DateTime @default(now()) @map("started_at")

  @@index([orgId, startedAt])
  @@index([orgId, agent, status])
  @@index([leadId, startedAt])
  @@map("agent_runs")
}

model Lead {
  id                  String   @id @default(uuid())
  orgId               String   @map("org_id")
  org                 Organization @relation(fields: [orgId], references: [id])
  runId               String?  @map("run_id")
  run                 ExtractionRun? @relation(fields: [runId], references: [id])
  filterId            String?  @map("filter_id")
  filter              NicheFilter? @relation(fields: [filterId], references: [id])
  campaignId          String?  @map("campaign_id")
  campaign            Campaign? @relation(fields: [campaignId], references: [id])
  assignedUserId       String?  @map("assigned_user_id")
  assignedUser         User?    @relation("AssignedUser", fields: [assignedUserId], references: [id])

  companyName         String   @map("company_name")
  /// Which method found this lead. Set once at creation, never changed after.
  sourceLayer         LeadSourceLayer @default(SURFACE_WEB) @map("source_layer")
  // Normalised forms used ONLY for duplicate detection, written on insert.
  // Comparing normalised values has to happen in the database, so the
  // normalisation must be persisted — computing it in TypeScript and then
  // querying on the raw column silently defeats itself.
  companyNameKey      String?  @map("company_name_key")
  linkedinSlug        String?  @map("linkedin_slug")
  website             String?
  websiteDomain       String?  @map("website_domain")
  linkedinUrl         String?  @map("linkedin_url")
  contactName         String?  @map("contact_name")
  jobTitle            String?  @map("job_title")
  email               String?
  personalEmail       String?  @map("personal_email")
  phone               String?
  industry            String?
  subNiche            String?  @map("sub_niche")
  country             String?
  city                String?
  companySize         String?  @map("company_size")
  revenueBand         String?  @map("revenue_band")
  employeeCount       Int?     @map("employee_count")
  techStack           Json     @default("[]") @map("tech_stack")
  businessModel       String?  @map("business_model")
  b2bOrB2c            String?  @map("b2b_or_b2c")
  businessDescription String?  @map("business_description")
  currentCrm          String?  @map("current_crm")

  // Contact's own LinkedIn, distinct from `linkedinUrl` above which is the
  // company page. Conflating the two loses the ability to research the person.
  contactLinkedinUrl  String?  @map("contact_linkedin_url")
  estimatedRevenue    String?  @map("estimated_revenue")
  websitePlatform     String?  @map("website_platform")
  automationTools     Json     @default("[]") @map("automation_tools")
  aiUsage             String?  @map("ai_usage")

  // Business intelligence gathered during discovery. Stored on the lead rather
  // than only in the review note, because these come from the AI's research and
  // exist before any human review — the reviewer edits them, they aren't
  // reviewer-authored.
  growthSignals           Json   @default("[]") @map("growth_signals")
  painPoints              String? @map("pain_points")
  aiOpportunities         String? @map("ai_opportunities")
  automationOpportunities String? @map("automation_opportunities")
  // Free-text evidence for what the finder claimed, so a reviewer can audit it.
  researchEvidence        String? @map("research_evidence")

  // Company Intelligence Agent output.
  swotAnalysis            Json    @default("{}") @map("swot_analysis")
  competitors             Json    @default("[]")
  recentNews              Json    @default("[]") @map("recent_news")
  marketingStack          Json    @default("[]") @map("marketing_stack")

  // Website Audit Agent output. Kept on the lead rather than only in the score
  // because a reviewer quotes these back to the prospect — they are evidence,
  // not just inputs to a number.
  uxIssues                String? @map("ux_issues")
  seoIssues               String? @map("seo_issues")

  // Buyer Intelligence Agent output.
  buyerPersona            String? @map("buyer_persona")

  verifiedEmail       Boolean  @default(false) @map("verified_email")
  verifiedLinkedin    Boolean  @default(false) @map("verified_linkedin")
  verifiedWebsite     Boolean  @default(false) @map("verified_website")
  possibleDuplicate   Boolean  @default(false) @map("possible_duplicate")

  createdAt           DateTime @default(now()) @map("created_at")
  lastActivityAt      DateTime? @map("last_activity_at")

  score               LeadScore?
  reviewNote          ReviewNote?
  agentReview         AgentReview?
  pipelineState       PipelineState?
  emailMessages       EmailMessage[]
  linkedinActivities  LinkedinActivity[]
  clickupSync         ClickupSync?
  sheetsSync          SheetsSync?
  auditLogs           AuditLog[]
  /// Every agent execution attributable to this lead, in run order — the
  /// per-lead trail behind the Automation dashboard's aggregate view.
  agentRuns           AgentRun[]
  notifications       Notification[]

  // Tier-1 exact-match dedup (Part C2) — unique per org on domain and email.
  @@unique([orgId, websiteDomain], name: "org_domain_unique")
  @@unique([orgId, email], name: "org_email_unique")
  @@index([orgId, industry])
  @@index([orgId, createdAt])
  // These four were hand-written SQL in earlier migrations and never declared
  // here, so a later `prisma migrate dev` read their absence as drift and
  // silently dropped them (2026-07-29 incident — recovered same day). Declaring
  // them is what stops that happening again: duplicate checks run on every
  // lead insert and must not be sequential scans.
  @@index([campaignId], map: "leads_campaign_id_idx")
  @@index([orgId, companyNameKey], map: "leads_org_company_name_key_idx")
  @@index([orgId, linkedinSlug], map: "leads_org_linkedin_slug_idx")
  @@index([orgId, linkedinUrl], map: "leads_org_linkedin_url_idx")
  @@map("leads")
}

model LeadScore {
  id                    String   @id @default(uuid())
  leadId                String   @unique @map("lead_id")
  lead                  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadScore             Int      @map("lead_score")
  confidenceScore       Int      @map("confidence_score")
  aiOpportunityScore    Int      @map("ai_opportunity_score")
  automationScore       Int      @map("automation_score")
  crmReadinessScore     Int      @map("crm_readiness_score")
  websiteQualityScore   Int      @map("website_quality_score")

  // The scoring rubric's remaining dimensions. Kept as separate columns rather
  // than folded into leadScore so a reviewer can see *why* a lead ranked where
  // it did — a single opaque number is not reviewable, and reviewer feedback is
  // what the scoring loop is meant to improve on.
  businessFitScore      Int?     @map("business_fit_score")
  buyingIntentScore     Int?     @map("buying_intent_score")
  budgetScore           Int?     @map("budget_score")
  technologyGapScore    Int?     @map("technology_gap_score")
  decisionMakerAccessScore Int?  @map("decision_maker_access_score")
  // Weighted roll-up of the six dimensions; what the pipeline sorts on.
  leadPriorityScore     Int?     @map("lead_priority_score")

  // Maturity scores from the Company Intelligence Agent, and buyer scores from
  // the Buyer Intelligence Agent. Separate from the six rubric dimensions
  // because they describe the company and the person, not the fit of the deal.
  digitalMaturityScore      Int?  @map("digital_maturity_score")
  aiReadinessScore          Int?  @map("ai_readiness_score")
  automationOpportunityScore Int? @map("automation_opportunity_score")
  authorityScore            Int?  @map("authority_score")
  engagementScore           Int?  @map("engagement_score")
  projectComplexity         String? @map("project_complexity")
  fitReason             String?  @map("fit_reason")
  suggestedServices     String?  @map("suggested_services")
  expectedValue         Decimal? @map("expected_value")
  priority              Priority?
  scoredAt              DateTime @default(now()) @map("scored_at")

  // The pipeline ranks by priority score, so make that ordering cheap. Was
  // hand-written SQL (DESC NULLS LAST) never declared here, and got silently
  // dropped by a later `prisma migrate dev` for the same reason as the Lead
  // indexes above (2026-07-29 incident). Prisma can't express NULLS LAST, so
  // this recreates it DESC only — still avoids a sort node for the common
  // case, though nulls (unscored leads) sort first rather than last.
  @@index([leadPriorityScore(sort: Desc)], map: "lead_scores_lead_priority_score_idx")
  @@map("lead_scores")
}

model ReviewNote {
  id                       String   @id @default(uuid())
  leadId                   String   @unique @map("lead_id")
  lead                     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reviewerId               String?  @map("reviewer_id")
  reviewer                 User?    @relation(fields: [reviewerId], references: [id])
  websiteIssues            String?  @map("website_issues")
  businessProblems         String?  @map("business_problems")
  opportunities            String?
  automationOpportunities  String?  @map("automation_opportunities")
  crmIssues                String?  @map("crm_issues")
  salesIssues              String?  @map("sales_issues")
  marketingIssues          String?  @map("marketing_issues")
  operationalIssues        String?  @map("operational_issues")
  suggestedService         String?  @map("suggested_service")
  suggestedOffer           String?  @map("suggested_offer")
  suggestedCaseStudy       String?  @map("suggested_case_study")
  suggestedHook            String?  @map("suggested_hook")
  painPoints               String?  @map("pain_points")
  urgencyLevel             UrgencyLevel? @map("urgency_level")
  expectedValue            Decimal? @map("expected_value")
  notes                    String?
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("review_notes")
}

/// The AI's own counterpart to ReviewNote above — same fields, but synthesised
/// by the `agent_review` agent from what the intelligence/scoring agents found
/// rather than typed by a person. Gives a reviewer a populated starting point
/// (agree, correct, or override) instead of a blank form, and is what a
/// manually-added lead gets in place of a human's review until one happens.
model AgentReview {
  id                       String   @id @default(uuid())
  leadId                   String   @unique @map("lead_id")
  lead                     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  websiteIssues            String?  @map("website_issues")
  businessProblems         String?  @map("business_problems")
  opportunities            String?
  automationOpportunities  String?  @map("automation_opportunities")
  crmIssues                String?  @map("crm_issues")
  salesIssues              String?  @map("sales_issues")
  marketingIssues          String?  @map("marketing_issues")
  operationalIssues        String?  @map("operational_issues")
  suggestedService         String?  @map("suggested_service")
  suggestedOffer           String?  @map("suggested_offer")
  suggestedCaseStudy       String?  @map("suggested_case_study")
  suggestedHook            String?  @map("suggested_hook")
  painPoints               String?  @map("pain_points")
  urgencyLevel             UrgencyLevel? @map("urgency_level")
  expectedValue            Decimal? @map("expected_value")
  notes                    String?
  generatedAt              DateTime @default(now()) @map("generated_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("agent_reviews")
}

model PipelineState {
  leadId          String   @id @map("lead_id")
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage           PipelineStage @default(NEW_LEAD)
  enteredStageAt  DateTime @default(now()) @map("entered_stage_at")
  nextActionAt    DateTime? @map("next_action_at")
  // BullMQ delayed-job id for the pending wait-timer (Part C6). Lets the
  // sequencer cancel an in-flight "wait 2 days" job the instant a reply or
  // manual stage change makes it moot, instead of letting it fire anyway.
  waitJobId       String?  @map("wait_job_id")
  // One level of undo: the stage this lead was in immediately before the
  // current one. "Back" swaps stage<->previousStage rather than replaying full
  // history, which is enough for correcting a wrong drag or retrying a stage
  // whose automation failed (e.g. no mailbox configured yet) without needing a
  // separate retry mechanism.
  previousStage   PipelineStage? @map("previous_stage")

  @@map("pipeline_states")
}

model EmailAccount {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  org          Organization @relation(fields: [orgId], references: [id])
  provider     EmailProvider
  address      String   @unique
  /// Shown as the From display name in the recipient's inbox (e.g. "EurosHub
  /// Sales" instead of the bare mailbox address). Falls back to the org-wide
  /// sender name (Settings > Email branding) when unset.
  displayName  String?  @map("display_name")
  dailyLimit   Int      @default(30) @map("daily_limit")
  hourlyLimit  Int      @default(5) @map("hourly_limit")
  warmupActive Boolean  @default(true) @map("warmup_active")
  status       EmailAccountStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")

  // GMAIL: OAuth2 refresh token for this mailbox (gmail.send + gmail.readonly
  // scopes — Part G1). Obtained out-of-band via a one-time consent flow, not
  // stored in .env since it's per-mailbox, not per-deployment.
  oauthRefreshToken String? @map("oauth_refresh_token")
  // Cursor into Gmail's history API (Part E2 gmail webhook) — lets the push
  // adapter fetch only what changed since the last processed notification
  // instead of replaying the whole mailbox history on every event.
  lastHistoryId     String? @map("last_history_id")

  // MICROSOFT_365 / SMTP: plain SMTP AUTH credentials. TODO(Part E4): these
  // belong in a secrets manager (Doppler/AWS Secrets Manager), not a plaintext
  // DB column — same caveat the design doc raises for provider API keys in
  // general; acceptable for this scaffold, flagged before going live.
  smtpHost     String? @map("smtp_host")
  smtpPort     Int?    @map("smtp_port")
  smtpUsername String? @map("smtp_username")
  smtpPassword String? @map("smtp_password")

  emailMessages EmailMessage[]

  @@map("email_accounts")
}

model EmailMessage {
  id            String   @id @default(uuid())
  leadId        String   @map("lead_id")
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  accountId     String?  @map("account_id")
  account       EmailAccount? @relation(fields: [accountId], references: [id])
  sequenceStep  Int      @map("sequence_step")
  subject       String
  bodyHtml      String   @map("body_html")
  rationale     Json?
  generatedBy   GeneratedBy @map("generated_by")
  status        EmailMessageStatus @default(DRAFT)
  scheduledAt   DateTime? @map("scheduled_at")
  sentAt        DateTime? @map("sent_at")

  events        EmailEvent[]

  @@index([leadId])
  @@map("email_messages")
}

model EmailEvent {
  id         String   @id @default(uuid())
  messageId  String   @map("message_id")
  message    EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  eventType  EmailEventType @map("event_type")
  occurredAt DateTime @default(now()) @map("occurred_at")
  meta       Json     @default("{}")

  @@map("email_events")
}

model LinkedinActivity {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  status    LinkedinStatus @default(NOT_STARTED)
  /// AI-drafted connectionNote/followUpMessage/secondFollowUp for a human to
  /// copy and send manually — LinkedIn automation itself stays out of scope
  /// (ToS/ban risk). Null until "Generate LinkedIn copy" has been used once.
  draftMessages Json?  @map("draft_messages")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("linkedin_activities")
}

model ClickupSync {
  leadId        String   @id @map("lead_id")
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clickupTaskId String   @map("clickup_task_id")
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at")

  @@map("clickup_syncs")
}

model SheetsSync {
  leadId       String   @id @map("lead_id")
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rowNumber    Int      @map("row_number")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  @@map("sheets_syncs")
}

model CaseStudy {
  id       String   @id @default(uuid())
  orgId    String   @map("org_id")
  org      Organization @relation(fields: [orgId], references: [id])
  industry String
  title    String
  summary  String
  metrics  Json     @default("{}")

  @@map("case_studies")
}

// Cross-sequence suppression list (Part C6 / I4 / I5) — checked before every
// single send, not just at sequence start. Populated from unsubscribe clicks,
// hard bounces, spam complaints, and manual do-not-contact entries.
model SuppressionEntry {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id])
  email     String
  reason    String // UNSUBSCRIBED | HARD_BOUNCE | SPAM_COMPLAINT | MANUAL
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orgId, email])
  @@map("suppression_entries")
}

model AuditLog {
  id        String   @id @default(uuid())
  leadId    String?  @map("lead_id")
  // SetNull rather than the default: deleting a lead must keep the audit
  // trail entry (who did what, when) even though the row it was about is
  // gone — losing accountability history is worse than an orphaned reference.
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  diff      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("audit_logs")
}

/// Surfaced when automatic recovery fails and a human genuinely needs to
/// know — an agent-dispatch job exhausting its retries, a pipeline hitting a
/// permanent failure. Everyday agent activity (OK/DEGRADED runs, normal
/// stage transitions) does NOT create one of these; that's what AgentRun and
/// the live event stream are for. A Notification means "autonomous recovery
/// could not fix this on its own."
model Notification {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id])
  leadId    String?  @map("lead_id")
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  type      String
  severity  String   @default("ERROR") // ERROR | WARNING
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId, read, createdAt])
  @@map("notifications")
}
