# ---- Core ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# ---- Database / Cache ----
# Supabase: use the transaction pooler (port 6543) for DATABASE_URL and the session pooler (port 5432) for DIRECT_URL (Prisma migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadgen
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/leadgen
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- AI Providers ----
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=

# ---- Verification providers ----
HUNTER_API_KEY=
NEVERBOUNCE_API_KEY=
BUILTWITH_API_KEY=

# ---- Google Workspace ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ---- ClickUp ----
CLICKUP_API_TOKEN=
CLICKUP_WEBHOOK_SECRET=
CLICKUP_TEAM_ID=
# Fallback List ID used when a niche filter doesn't have its own clickupListId configured.
CLICKUP_DEFAULT_LIST_ID=

# ---- Email sending ----
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# ---- Internal service-to-service auth (API <-> AI workers) ----
INTERNAL_SERVICE_TOKEN=change-me-internal-token
AI_WORKERS_URL=http://localhost:8000
ORG_POSTAL_ADDRESS=

# ---- Observability ----
SENTRY_DSN=
